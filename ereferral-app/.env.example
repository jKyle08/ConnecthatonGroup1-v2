PORT=3000
# Optional SQL Server (not required when USE_PERSISTENT_LOCAL_DB=false)
SQL_SERVER=YOUR_SQL_HOST
SQL_DATABASE=EReferralLocal
SQL_WINDOWS_AUTH=true
SQL_ENCRYPT=false
SQL_TRUST_CERT=true
SQL_USER=ereferral_app
SQL_PASSWORD=CHANGE_ME
FHIR_BASE_URL=https://cdr.pheref.fhirlab.net/fhir
TX_BASE_URL=https://tx.fhirlab.net/fhir
PRACTITIONER_ROLE_VS=https://www.fhir.doh.gov.ph/pheref/ValueSet/practitioner-role
REFERRAL_CATEGORY_VS=https://www.fhir.doh.gov.ph/pheref/ValueSet/referral-category
PSGC_SYSTEM=https://psa.gov.ph/classification/psgc
PSGC_VERSION=1Q-2026
TEAM_PREFIX=TEAM07
# Persistent local SQLite is off by default (in-memory scratch only).
# Set true to restore ereferral-local.db pull/push sync.
USE_PERSISTENT_LOCAL_DB=false
DEFAULT_FACILITY_FHIR_ID=23329
DEFAULT_FACILITY_NAME=Connectathon Facility
DEFAULT_FACILITY_NHFR=6592
DEFAULT_FACILITY_HCPN=6592
DEFAULT_FACILITY_PHONE=09999999989
DEFAULT_FACILITY_ADDRESS=Main Highway
